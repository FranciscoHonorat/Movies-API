# Template only — DO NOT `kubectl apply -f` this file as-is, and never commit
# a real secrets.yaml with actual credentials (that's exactly the mistake the
# ADR flagged in the old k8s/*-deployment.yaml, which had "root:password" and
# "guest:guest" typed directly into the Deployment spec, in cleartext, in
# git history forever).
#
# Copy this file to secrets.yaml (already in .gitignore, see infra/README.md),
# fill in real values, then:
#   kubectl apply -f infra/kubernetes/secrets.yaml
#
# Or, better for anything beyond local study use, generate it without ever
# writing plaintext to disk:
#   kubectl create secret generic re-api-books-secrets \
#     --from-literal=MONGO_ROOT_USER=root \
#     --from-literal=MONGO_ROOT_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=MONGO_URI="mongodb://root:<same-password>@mongo-service:27017/movies?authSource=admin" \
#     --from-literal=RABBITMQ_USER=guest \
#     --from-literal=RABBITMQ_PASSWORD="$(openssl rand -base64 24)" \
#     --from-literal=RABBITMQ_URI="amqp://guest:<same-password>@rabbitmq-service:5672/" \
#     -n re-api-books-dev
#
# `stringData` (plaintext in the manifest, base64-encoded by the API server
# on apply) is used here instead of `data` (pre-encoded) only because this
# file is a template meant to be hand-edited — base64 is encoding, not
# encryption, either way; it does not make committing real values safe.
apiVersion: v1
kind: Secret
metadata:
  name: re-api-books-secrets
type: Opaque
stringData:
  MONGO_ROOT_USER: "root"
  MONGO_ROOT_PASSWORD: "CHANGE_ME"
  MONGO_URI: "mongodb://root:CHANGE_ME@mongo-service:27017/movies?authSource=admin"
  RABBITMQ_USER: "guest"
  RABBITMQ_PASSWORD: "CHANGE_ME"
  RABBITMQ_URI: "amqp://guest:CHANGE_ME@rabbitmq-service:5672/"
