# Docker Compose Environment Variables

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=password
MONGO_DB_NAME=movies
MONGO_PORT=27017

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Movies Service
MOVIES_GRPC_PORT=50051
# Goroutines concorrentes consumindo movies_queue no RabbitMQ. Ver
# docs/adr/0005-*.md para o porquê de 4 e como escalar isso.
CONSUMER_WORKERS=4

# API Gateway
API_GATEWAY_PORT=8080
GIN_MODE=release

# Hermes (metrics only — tracing stays on Jaeger, see docs/adr/0008-*.md)
# host.docker.internal is how api-gateway/movies-service, on their own
# movies-network bridge, reach the Hermes Collector published on the host
# at :4000 by a completely separate docker-compose stack.
HERMES_COLLECTOR_URL=http://host.docker.internal:4000
# Blank in dev — set only if the Hermes Collector's COLLECTOR_API_KEYS is configured.
HERMES_API_KEY=