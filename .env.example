# Docker Compose Environment Variables

# MongoDB
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=password
MONGO_DB_NAME=movies
MONGO_PORT=27017

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Movies Service
MOVIES_GRPC_PORT=50051
# Goroutines concorrentes consumindo movies_queue no RabbitMQ. Ver
# docs/adr/0005-*.md para o porquê de 4 e como escalar isso.
CONSUMER_WORKERS=4

# API Gateway
API_GATEWAY_PORT=8080
GIN_MODE=release